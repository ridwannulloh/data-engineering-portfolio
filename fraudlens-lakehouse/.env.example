# All values below are the local-dev defaults already baked into
# docker-compose.yml — you only need this file when running the pipeline
# OUTSIDE Docker (e.g. `python -m src.generate_data` on your host).

# "s3" writes Delta tables to MinIO via s3a://, "local" writes to a local dir.
STORAGE_BACKEND=s3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
LAKEHOUSE_BUCKET=lakehouse

# Used when STORAGE_BACKEND=local (tests use this mode).
LOCAL_LAKEHOUSE_DIR=./lakehouse

RAW_DATA_DIR=./data/raw
DATA_NUM_ROWS=50000
