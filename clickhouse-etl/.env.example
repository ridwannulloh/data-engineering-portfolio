# --- ClickHouse Cloud -------------------------------------------------------
# Console -> your service -> Connect -> HTTPS. Port 8443, TLS on.
CLICKHOUSE_HOST=xxxxxxxx.ap-southeast-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# Idle Cloud services wake on first connect; give them time.
CLICKHOUSE_CONNECT_TIMEOUT=30

# Rows per INSERT for the synthetic event loader. load-taxi uses server-side Parquet ingestion.
ETL_BATCH_SIZE=50000

# --- Local docker (make up) -------------------------------------------------
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_PASSWORD=localdev
# CLICKHOUSE_SECURE=false
