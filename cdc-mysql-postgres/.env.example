# ─────────────────────────────────────────────────────────────────────────
# Reference values for the existing local Docker databases this project
# connects to. These are consumed by scripts/seed-dbs.sh (and documented for
# the connector configs). Copy to .env and override if your setup differs.
#
# NOTE: the connector JSON files (connectors/*.json) reference the databases
# through host.docker.internal on the host's published ports — update them too
# if you change hosts/ports/credentials.
# ─────────────────────────────────────────────────────────────────────────

# ── Source: MySQL (container mysql-local) ─────────────────────────────────
MYSQL_CONTAINER=mysql-local
MYSQL_HOST=host.docker.internal     # how the Connect container reaches MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PW=root123
# Dedicated CDC user created by sql/mysql_schema.sql
DEBEZIUM_USER=debezium
DEBEZIUM_PW=dbz

# ── Target: PostgreSQL (container local-postgres) ─────────────────────────
PG_CONTAINER=local-postgres
PG_HOST=host.docker.internal        # how the Connect container reaches Postgres
PG_PORT=5432
PG_USER=postgres
PG_PW=postgres
PG_DB=ecommerce

# ── Kafka Connect REST endpoint (from the host) ───────────────────────────
CONNECT_URL=http://localhost:8083
